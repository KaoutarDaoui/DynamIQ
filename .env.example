# --- Supabase REST API (For Supabase SDK) ---
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_KEY="<your-publishable-key>"

SUPABASE_SERVICE_KEY="<your-service-role-key>"

# Groq keys for diagnostic agent LLM calls
GROQ_API_KEY="<your-groq-api-key>"
DIAGNOSTIC_GROQ_API_KEY="<your-diagnostic-groq-api-key>"
GROQ_DIAGNOSTIC_MODEL="qwen/qwen3.6-27b"

# --- Direct PostgreSQL Connection (For SQLAlchemy / SQLModel ORM) ---
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/postgres"

# Optional: email alerts when Agent 4 routes a diagnosis to a human.
# The SMTP host/user/password are the sending account and must all be set to
# activate the channel. Works with a Gmail App Password:
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
# Use the generated 16-character password here, not your normal password.
#
# SUPERVISOR_ALERT_EMAIL_TO is only a fallback recipient for buildings whose
# organisation has no email on file (Settings -> Building -> Alert email in
# the app is the normal way to set the real per-building recipient).
SUPERVISOR_ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
SUPERVISOR_ALERT_EMAIL_SMTP_PORT=465
SUPERVISOR_ALERT_EMAIL_SMTP_USER=
SUPERVISOR_ALERT_EMAIL_SMTP_PASSWORD=
SUPERVISOR_ALERT_EMAIL_TO=
