# Anthropic API (used locally in place of Amazon Bedrock for the Diagnostic
# and Supervisor agents — swap for a Bedrock client at deployment time)
ANTHROPIC_API_KEY=

# ElectricityMaps (hourly grid carbon intensity). Optional — falls back to a
# static regional profile if unset.
ELECTRICITYMAPS_API_KEY=
ELECTRICITYMAPS_ZONE=DZ

# Open-Meteo needs no key.

# Building coordinates used for weather + carbon lookups (default: Algiers)
BUILDING_LAT=36.7538
BUILDING_LON=3.0588
