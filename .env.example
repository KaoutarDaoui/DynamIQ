# --- Supabase REST API (For Supabase SDK) ---
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_KEY="<your-publishable-key>"

SUPABASE_SERVICE_KEY="<your-service-role-key>"

# Groq keys for diagnostic agent LLM calls
GROQ_API_KEY="<your-groq-api-key>"
DIAGNOSTIC_GROQ_API_KEY="<your-diagnostic-groq-api-key>"
GROQ_DIAGNOSTIC_MODEL="qwen/qwen3.6-27b"

# --- Direct PostgreSQL Connection (For SQLAlchemy / SQLModel ORM) ---
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/postgres"
