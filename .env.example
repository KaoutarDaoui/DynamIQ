# --- Supabase REST API (For Supabase SDK) ---
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_KEY="<your-publishable-key>"

SUPABASE_SERVICE_KEY="<your-service-role-key>"

# Groq keys for diagnostic agent LLM calls
GROQ_API_KEY="<your-groq-api-key>"
DIAGNOSTIC_GROQ_API_KEY="<your-diagnostic-groq-api-key>"
GROQ_DIAGNOSTIC_MODEL="qwen/qwen3.6-27b"

# --- Direct PostgreSQL Connection (For SQLAlchemy / SQLModel ORM) ---
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/postgres"

# Optional: email alerts when Agent 4 routes a diagnosis to a human.
# Two ways to activate the "email" channel -- EmailJS takes priority if both
# are set. *_TO in either is only a fallback recipient for buildings whose
# organisation has no email/user account on file (Settings -> Building ->
# Alert email in the app is the normal way to set the real recipient).

# Option A -- EmailJS (emailjs.com free tier). Create an Email Service +
# Email Template there, enable "non-browser applications" under
# Account -> Security, then fill in the service/template/key IDs below.
SUPERVISOR_ALERT_EMAILJS_SERVICE_ID=
SUPERVISOR_ALERT_EMAILJS_TEMPLATE_ID=
SUPERVISOR_ALERT_EMAILJS_PUBLIC_KEY=
SUPERVISOR_ALERT_EMAILJS_PRIVATE_KEY=
SUPERVISOR_ALERT_EMAILJS_TO=

# Option B -- raw SMTP (e.g. Gmail App Password, or Brevo/SendGrid). All
# three of host/user/password must be set to activate this path.
SUPERVISOR_ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
SUPERVISOR_ALERT_EMAIL_SMTP_PORT=465
SUPERVISOR_ALERT_EMAIL_SMTP_USER=
SUPERVISOR_ALERT_EMAIL_SMTP_PASSWORD=
SUPERVISOR_ALERT_EMAIL_TO=
